# Anthropic API key. Dejalo vacio y el analyzer usara un mock determinista.
# Nunca subas una API key real a GitHub/Railway como ejemplo.
ANTHROPIC_API_KEY=

# Modelos
ANALYSIS_MODEL=claude-sonnet-4-6
PRESCREEN_MODEL=claude-haiku-4-5-20251001
EMBEDDING_MODEL=claude-haiku-4-5-20251001

# Scraping
SCRAPER_USER_AGENT=SesgometroBot/0.1 (+https://sesgometro.com; contact=tu-email@example.com)
SCRAPER_TIMEOUT_SECONDS=15

# CORS. Para Railway, reemplazar por la URL publica del frontend.
# Se pueden separar varios origenes con coma.
FRONTEND_ORIGIN=http://localhost:5173

# Base de datos
# Railway Postgres: usar la DATABASE_URL que expone el servicio Postgres.
# SQLite local: sqlite:///./sesgometro.db
DATABASE_URL=sqlite:///./sesgometro.db

# Scheduler
REFRESH_INTERVAL_MINUTES=180
ARTICLES_PER_PORTAL=5
RUN_INITIAL_REFRESH=true

# Auth. En produccion, configurar un valor fuerte y estable.
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=43200

# Clustering
CLUSTER_SIMILARITY_THRESHOLD=0.55
CLUSTER_TIME_WINDOW_HOURS=48
